  "foundation": {
    "$description": "Type, space, shape, elevation, motion, layout (design v6, Fluent 2 values from @fluentui/tokens). One ramp for every platform; sizes in px (web converts to rem).",
    "font": {
      "family": "Be Vietnam Pro",
      "fallback": "'Segoe UI Variable', 'Segoe UI', system-ui, -apple-system, Roboto, sans-serif",
      "mono": "ui-monospace, SFMono-Regular, Consolas, monospace",
      "weights": {
        "regular": 400,
        "medium": 500,
        "semibold": 600,
        "bold": 700,
        "extrabold": 800
      },
      "$note": "Fluent 2 uses regular and semibold; bold only for the wordmark-sized display, extrabold for the wordmark"
    },
    "type": {
      "display": {
        "size": 40,
        "lineHeight": 52,
        "weight": "semibold",
        "tracking": 0,
        "$use": "Fluent Large Title: landing hero, one per page"
      },
      "title1": {
        "size": 28,
        "lineHeight": 36,
        "weight": "semibold",
        "tracking": 0,
        "$use": "Fluent Title 2: page title"
      },
      "title2": {
        "size": 20,
        "lineHeight": 28,
        "weight": "semibold",
        "tracking": 0,
        "$use": "Fluent Subtitle 1: section title"
      },
      "title3": {
        "size": 16,
        "lineHeight": 22,
        "weight": "semibold",
        "tracking": 0,
        "$use": "Fluent Subtitle 2: card title, dialog title, list group"
      },
      "body": {
        "size": 16,
        "lineHeight": 22,
        "weight": "regular",
        "tracking": 0,
        "$use": "running text on phones, long reading on the web"
      },
      "bodySm": {
        "size": 14,
        "lineHeight": 20,
        "weight": "regular",
        "tracking": 0,
        "$use": "Fluent Body 1: the default text of web pages, dense lists, tables"
      },
      "label": {
        "size": 14,
        "lineHeight": 20,
        "weight": "semibold",
        "tracking": 0,
        "$use": "Fluent Body 1 Strong: buttons, tabs, field labels"
      },
      "caption": {
        "size": 12,
        "lineHeight": 16,
        "weight": "regular",
        "tracking": 0,
        "$use": "Fluent Caption 1: timestamps, badges, help text"
      }
    },
    "space": {
      "0": 0,
      "1": 4,
      "2": 8,
      "3": 12,
      "4": 16,
      "5": 20,
      "6": 24,
      "8": 32,
      "10": 40,
      "12": 48,
      "16": 64
    },
    "radius": {
      "xs": 2,
      "control": 4,
      "card": 8,
      "sheet": 12,
      "full": 999,
      "$note": "Fluent: xs (Small) badges and tags; control (Medium) buttons, inputs, chips, tabs, list rows; card (X-Large 8) cards, dialogs, menus, popovers, images; sheet 12 the top of a bottom sheet; full avatars, switches, dots only"
    },
    "elevation": {
      "flat": "none",
      "shadow2": "0 0 2px rgba(0,0,0,0.12), 0 1px 2px rgba(0,0,0,0.14)",
      "card": "0 0 2px rgba(0,0,0,0.12), 0 2px 4px rgba(0,0,0,0.14)",
      "raised": "0 0 2px rgba(0,0,0,0.12), 0 4px 8px rgba(0,0,0,0.14)",
      "overlay": "0 0 2px rgba(0,0,0,0.12), 0 8px 16px rgba(0,0,0,0.14)",
      "sheet": "0 0 8px rgba(0,0,0,0.12), 0 14px 28px rgba(0,0,0,0.14)",
      "dialog": "0 0 8px rgba(0,0,0,0.12), 0 32px 64px rgba(0,0,0,0.14)",
      "$note": "Fluent shadow2/4/8/16/28/64: card = shadow4 (content on the canvas, instead of a border), raised = shadow8 (hover, sticky bars), overlay = shadow16 (menus, popovers, snackbars), sheet = shadow28, dialog = shadow64"
    },
    "motion": {
      "fast": 150,
      "base": 200,
      "slow": 300,
      "easeStandard": "cubic-bezier(0.33, 0, 0.67, 1)",
      "easeExit": "cubic-bezier(0.9, 0.1, 1, 0.2)",
      "easeEnter": "cubic-bezier(0.1, 0.9, 0.2, 1)",
      "$note": "Fluent durationFast/Normal/Slow and curveEasyEase / AccelerateMax / DecelerateMax. Off when the user asks for reduced motion."
    },
    "layout": {
      "breakpoints": {
        "md": 640,
        "lg": 1024,
        "xl": 1366
      },
      "columns": {
        "base": 4,
        "md": 8,
        "lg": 12
      },
      "gutter": {
        "base": 16,
        "md": 16,
        "lg": 24
      },
      "pagePadding": {
        "base": 16,
        "lg": 24
      },
      "cardPadding": 16,
      "cardGap": 12,
      "sectionGap": 24,
      "contentMax": 1200,
      "readingMax": 680,
      "touchMin": 44
    },
    "icon": {
      "library": "lucide",
      "stroke": 1.5,
      "sizes": {
        "sm": 16,
        "md": 20,
        "lg": 24
      }
    }
  }
}
