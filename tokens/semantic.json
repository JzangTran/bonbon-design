{
  "$description": "Semantic colour roles: what a colour is for, in light and dark. Screens and components only use these. A value is a hex colour or a reference {palette.step}. Pairs that must stay readable are listed in contrast.json and checked by the tests.",
  "background":       { "light": "{stone.0}",   "dark": "{stone.950}", "$description": "page ground" },
  "surface":          { "light": "{stone.0}",   "dark": "#1F1C19",     "$description": "cards, sheets, panels on the page" },
  "surfaceSubtle":    { "light": "{stone.50}",  "dark": "{stone.850}", "$description": "quiet fills: search field, selected row, grouped section" },
  "surfaceStrong":    { "light": "{stone.100}", "dark": "#2A2623",     "$description": "pressed fill, skeleton, track of a progress bar" },
  "imageSlot":        { "light": "{stone.100}", "dark": "#2A2623",     "$description": "an image that has not loaded or does not exist" },
  "overlay":          { "light": "rgba(28,26,24,0.48)", "dark": "rgba(0,0,0,0.6)", "$description": "scrim behind dialogs and sheets" },

  "border":           { "light": "{stone.200}", "dark": "#38332E",     "$description": "hairline around a card or between regions" },
  "borderStrong":     { "light": "{stone.300}", "dark": "#4A443E",     "$description": "outline of an input, checkbox, unselected chip" },
  "divider":          { "light": "{stone.100}", "dark": "#2A2623",     "$description": "line between list rows" },

  "text":             { "light": "{stone.900}", "dark": "#F3F1EE",     "$description": "titles and body" },
  "textSecondary":    { "light": "{stone.600}", "dark": "#C4BEB6",     "$description": "descriptions, metadata" },
  "textTertiary":     { "light": "{stone.500}", "dark": "#9D968D",     "$description": "captions, placeholders, timestamps" },
  "textDisabled":     { "light": "{stone.400}", "dark": "#6B655E",     "$description": "disabled controls only (exempt from contrast)" },

  "accent":           { "light": "{orange.600}", "dark": "#FF8A52",    "$description": "the one primary action, selected item, focus" },
  "accentHover":      { "light": "{orange.700}", "dark": "#FFA275" },
  "accentPressed":    { "light": "{orange.800}", "dark": "#FFB38C" },
  "onAccent":         { "light": "#FFFFFF",      "dark": "{stone.950}", "$description": "text and icons on accent" },
  "accentSubtle":     { "light": "{orange.50}",  "dark": "#3A2216",    "$description": "selected chip, selected nav item fill" },
  "onAccentSubtle":   { "light": "{orange.700}", "dark": "#FFB38C" },
  "accentBorder":     { "light": "{orange.200}", "dark": "#6B3420" },
  "link":             { "light": "{orange.700}", "dark": "#FF9B6B",    "$description": "links in text: the darker orange, readable at 14px" },
  "focusRing":        { "light": "{orange.600}", "dark": "#FF8A52" },
  "brand":            { "light": "{orange.500}", "dark": "{orange.400}", "$description": "logo, mascot, large brand shapes; never text" },

  "neutralAction":    { "light": "{stone.900}", "dark": "#F3F1EE",     "$description": "a strong secondary action (dark button)" },
  "onNeutralAction":  { "light": "#FFFFFF",     "dark": "{stone.950}" },

  "success":          { "light": "{green.600}", "dark": "{green.300}", "$description": "paid, delivered, approved" },
  "successSubtle":    { "light": "{green.50}",  "dark": "{green.900}" },
  "onSuccessSubtle":  { "light": "{green.700}", "dark": "#8FDCAA" },
  "warning":          { "light": "{amber.600}", "dark": "{amber.300}", "$description": "needs attention soon; amber so it never reads as the orange brand" },
  "warningSubtle":    { "light": "{amber.50}",  "dark": "{amber.900}" },
  "onWarningSubtle":  { "light": "{amber.700}", "dark": "{amber.300}" },
  "danger":           { "light": "{red.600}",   "dark": "{red.300}",   "$description": "errors, destructive actions, rejected" },
  "onDanger":         { "light": "#FFFFFF",     "dark": "{stone.950}" },
  "dangerSubtle":     { "light": "{red.50}",    "dark": "{red.900}" },
  "onDangerSubtle":   { "light": "{red.700}",   "dark": "#FFB0A8" },
  "info":             { "light": "{blue.600}",  "dark": "{blue.300}",  "$description": "in progress, neutral news" },
  "infoSubtle":       { "light": "{blue.50}",   "dark": "{blue.900}" },
  "onInfoSubtle":     { "light": "{blue.700}",  "dark": "#B5CBFF" },
  "promo":            { "light": "{orange.700}", "dark": "#FF9B6B",    "$description": "discount and voucher labels" },
  "promoSubtle":      { "light": "{orange.50}",  "dark": "#3A2216" },

  "chart1":           { "light": "{orange.600}", "dark": "#FF8A52" },
  "chart2":           { "light": "#2A78D6",      "dark": "#5C9BEA" },
  "chart3":           { "light": "#1B9E6E",      "dark": "#3CC28F" },
  "chart4":           { "light": "{orange.900}", "dark": "{orange.200}" },
  "chart5":           { "light": "{amber.600}",  "dark": "{amber.300}" },
  "chartGrid":        { "light": "{stone.100}",  "dark": "#2A2623" },
  "chartAxis":        { "light": "{stone.300}",  "dark": "#4A443E" }
}
